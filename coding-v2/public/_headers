# Cabeçalhos para o Cloudflare Pages (a Vercel usa o vercel.json da raiz; as regras são as mesmas).
# Ícones versionados por hash (/brand/h/<hash>/...): o endereço muda quando o conteúdo muda, então podem ficar em cache para sempre.
/brand/h/*
  Cache-Control: public, max-age=31536000, immutable

# O manifesto e o service worker precisam ser revalidados a cada visita: é por eles que o navegador descobre a logo nova.
/manifest.webmanifest
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: application/manifest+json; charset=utf-8
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
/favicon.ico
  Cache-Control: public, max-age=0, must-revalidate
